# Non-secret configuration for the Cirro Data Transfer Utility.
# Copy to .env and adjust. Credentials do NOT go here — see the README
# "Credentials" section (Cirro uses in-app login; sources use ambient
# SDK credentials such as gcloud ADC or the AWS credential chain).

# Cirro tenant host (host only, no scheme).
CIRRO_BASE_URL=app.cirro.bio

# Where the SQLite DB and staging tempdirs live.
# CIRRO_TRANSFER_HOME=~/.cirro-transfer

# Datasets transferred concurrently.
CIRRO_TRANSFER_CONCURRENCY=1
